// Hand-expanded native reference for tests/generators.sflp. This small fixture
// checks parallel memory semantics; it is not a workaround for large modules.
circuit p27 {
    input load, wr, addr<2>, a<8>, bits<4>;
    output q0<8>, q1<8>, q2<8>, q3<8>, first<3>, mask<4>, local_count<8>;
    mem cells[4]<8> = {0};
    reg_wr count0<8>, count1<8>, count2<8>, count3<8>;
    if(load) par {
        cells[0b00] := a+0; cells[0b01] := a+1;
        cells[0b10] := a+2; cells[0b11] := a+3;
    }
    if(wr) cells[addr] := a;
    if(bits<0>) count0++;
    if(bits<1>) count1++;
    if(bits<2>) count2++;
    if(bits<3>) count3++;
    if(addr==0) local_count=count0;
    if(addr==1) local_count=count1;
    if(addr==2) local_count=count2;
    if(addr==3) local_count=count3;
    alt { bits<0> : first=0; bits<1> : first=1;
          bits<2> : first=2; bits<3> : first=3; else : first=7; }
    any { bits<0> : mask=0b0001<<0; bits<1> : mask=0b0001<<1;
          bits<2> : mask=0b0001<<2; bits<3> : mask=0b0001<<3; else : mask=0; }
    q0=cells[0b00]; q1=cells[0b01]; q2=cells[0b10]; q3=cells[0b11];
}
